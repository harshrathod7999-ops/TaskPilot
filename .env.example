# ============================================================
#  TaskPilot — environment variables (ALL FREE / FREE-TIER)
#  Copy to .env (in this folder) and fill in. NEVER commit real keys.
#  TaskPilot is fully self-contained; it needs no files outside this folder.
# ============================================================

# --- LLM providers (free) — the agent reasons with these ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx          # https://console.groq.com/keys
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx       # https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx       # LiteLLM reads Gemini via this name too

# --- Model routing: 3-model chain (each has an independent rate-limit quota) ---
PRIMARY_MODEL=groq/openai/gpt-oss-120b        # Groq: ~30 RPM / 1K RPD
FALLBACK_MODEL=gemini/gemini-3.5-flash         # Gemini Flash: ~15 RPM (separate quota)
FALLBACK_MODEL_2=gemini/gemini-3.1-flash-lite  # Flash Lite: ~30 RPM (separate quota)

# --- Observability: Langfuse (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agent limits ---
AGENT_MAX_STEPS=8                 # hard cap on plan/act loops (prevents runaway agents)
AGENT_MAX_CRITIQUES=2             # how many times the critic can send work back
TOOL_TIMEOUT_SECONDS=20

# --- API ---
TASKPILOT_API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MCP custom tool server (task tracker) ---
TASKPILOT_DB=tasks.db             # SQLite file the MCP server writes to (relative to backend/)

# --- Agent durability + run history ---
AGENT_DB=agent.db                 # SQLite file for checkpoints (AsyncSqliteSaver) + run history
                                   # (relative to backend/); mount a persistent volume in prod
                                   # if the paused-run-survives-a-restart property should hold
                                   # across deploys, not just within one instance's lifetime.
